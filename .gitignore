node_modules/
dist/
.claude/
.DS_Store

# Foreman working docs (specs, ledgers, pentest artifacts)
Docs/

# docs/ holds internal working notes; only the allowlisted file is published.
# Everything else under docs/ stays local (it may carry internal references).
!docs/
docs/*
!docs/compression-benchmarks.md
!docs/0.5.11/
docs/0.5.11/*
!docs/0.5.11/DesignConcept.md

# Local experiment workspace. Keep only the folder marker in git so review
# tooling does not scan synthetic target applications or generated outputs.
Test_dojo/**
!Test_dojo/
!Test_dojo/.gitkeep

# Local package/install artifacts
foreman-mcp/.npm-cache/
foreman-mcp/*.tgz

# Python harness bytecode (foreman-mcp/scripts/aider_harness.py)
__pycache__/
*.pyc

# Keep assets/ but ignore generation prompts
assets/prompts.md

# CI-only release pack output. The committed artifacts/ folder is the
# archival history; release-pkg/ is the per-build staging dir used by the
# build workflow so the Release upload only ships the current version.
release-pkg/

# Vendored context-crush build is committed: it is the in-repo dependency so
# CI `npm ci` resolves it (no external path / registry), and bundleDependencies
# packs it into the tarball. Override the global dist/ ignore for this path only.
!foreman-mcp/vendor/context-crush/dist/
!foreman-mcp/vendor/context-crush/dist/**

# Foreman local worker endpoint config (never commit)
.foremanenv

# Temp/scratch directories and files
temp/
tmp/
.tmp/
*.tmp
.aider.chat.history.md
.aider.input.history
dojo/T1-semver/local-repaired/semver.mjs
.vscode/.checkmarxIgnored
